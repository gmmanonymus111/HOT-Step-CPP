+// HOT-Step patch: cpy-q-occupancy - see engine/patches/cpy-q-occupancy.patch
+//
+// Upstream launches every quant->F32 copy as <<<ne, 1>>>: one CUDA BLOCK per
+// ELEMENT, one thread inside it. The kernel body indexes i = tid*qk and bails
+// on `i >= ne`, so 31 of every 32 blocks (qk = 32) do nothing but hit the
+// guard, and each surviving thread runs alone in a 32-lane warp. Residency
+// caps at ~32 blocks/SM, and a copy that should be bandwidth-bound becomes
+// launch-bound.
+//
+// The fix is the launch shape ONLY. The index expression already reads
+// blockDim.x, so packing CUDA_CPY_BLOCK_SIZE threads per block hands each
+// thread the same element it would have had as a lone block: identical work,
+// identical output, far more resident threads. The scalar (F16/F32) copies in
+// this same file already launch exactly this way.
+//
+// The sibling F32->quant launches below have the same 1-thread-per-block shape
+// but the correct block COUNT (ne/qk), so they waste occupancy without wasting
+// blocks. Left alone deliberately: they are an inference path (quantized KV
+// cache), not the training path this patch was measured against.
 static void ggml_cpy_q8_0_f32_cuda(
     const char * cx, char * cdst, const int64_t ne,
     const int64_t ne00, const int64_t ne01, const int64_t ne02, const int64_t nb00, const int64_t nb01, const int64_t nb02,
     const int64_t nb03, const int64_t ne10, const int64_t ne11, const int64_t ne12, const int64_t nb10, const int64_t nb11, const int64_t nb12, const int64_t nb13, cudaStream_t stream) {
 
-    const int64_t num_blocks = ne;
+    // HOT-Step patch: cpy-q-occupancy - see engine/patches/cpy-q-occupancy.patch
+    const int64_t num_work   = (ne + QK8_0 - 1) / QK8_0;
+    const int64_t num_blocks = (num_work + CUDA_CPY_BLOCK_SIZE - 1) / CUDA_CPY_BLOCK_SIZE;
     GGML_ASSERT(num_blocks <= INT_MAX);
-    cpy_q_f32<cpy_blck_q8_0_f32, QK8_0><<<num_blocks, 1, 0, stream>>>
+    cpy_q_f32<cpy_blck_q8_0_f32, QK8_0><<<num_blocks, CUDA_CPY_BLOCK_SIZE, 0, stream>>>
         (cx, cdst, ne, ne00, ne01, ne02, nb00, nb01, nb02, nb03, ne10, ne11, ne12, nb10, nb11, nb12, nb13);
 }
 
